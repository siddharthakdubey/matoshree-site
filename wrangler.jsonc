{
  "name": "matoshree-site",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "matoshree-db",
      "database_id": "650bc008-9a21-4ddc-8523-2cee2273e35d"
    }
  ]
}
